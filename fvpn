def _data_dir() -> Path:
    """Prefer ~/.fvpn. If a previous root run left it unwritable, fall back to
    Application Support instead of failing (no sudo needed to recover)."""
    env = os.environ.get("FVPN_HOME")
    if env:
        return Path(env).expanduser()
    primary = HOME / ".fvpn"
    try:
        primary.mkdir(parents=True, exist_ok=True)
        if os.access(primary, os.W_OK | os.X_OK):
            return primary
    except OSError:
        pass
    return HOME / "Library" / "Application Support" / "fvpn"


