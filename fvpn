TTY = sys.stdout.isatty()
NO_COLOR = bool(os.environ.get("NO_COLOR"))


def col(txt: str, code: str) -> str:
    if not TTY or NO_COLOR:
        return txt
    return f"\033[{code}m{txt}\033[0m"


def dim(t: str) -> str:
    return col(t, "2")


def bold(t: str) -> str:
    return col(t, "1")


def green(t: str) -> str:
    return col(t, "32")


def red(t: str) -> str:
    return col(t, "31")


def yellow(t: str) -> str:
    return col(t, "33")


def cyan(t: str) -> str:
    return col(t, "36")


def say(msg: str = "") -> None:
    print(msg, flush=True)


def note(msg: str) -> None:
    """Diagnostics go to stderr so they never pollute parsed output."""
    print(dim(msg), file=sys.stderr, flush=True)


def normalize_terminal() -> None:
    """A TUI (agy) can exit with the tty in raw mode; then newlines no longer
    return to column 0 and every line is indented further than the last."""
    if not sys.stdout.isatty():
        return
    try:
        out = subprocess.run(["stty", "-a"], capture_output=True, text=True, timeout=2).stdout
        if "-onlcr" in out or "-opost" in out:
            subprocess.run(["stty", "opost", "onlcr"], capture_output=True, timeout=2)
    except Exception:
        pass


def die(msg: str, code: int = 1) -> "NoReturn":
    say(red(f"fvpn: {msg}"))
    sys.exit(code)


def human_bytes(n: float) -> str:
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{int(n)} B"
        n /= 1024
    return f"{n:.1f} TB"


def human_uptime(seconds: float) -> str:
    s = int(max(0, seconds))
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    if h:
        return f"{h}h {m}m"
    if m:
        return f"{m}m {s}s"
    return f"{s}s"


# ---------------------------------------------------------------- fs helpers

def ensure_dirs() -> None:
    global _WARNED
    DIR.mkdir(parents=True, exist_ok=True)
    PROVIDERS.mkdir(parents=True, exist_ok=True)
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(DIR, 0o700)
    except OSError:
        pass
    if FALLBACK_HOME and not _WARNED:
        _WARNED = True
        marker = DIR / ".root-dir-notice"
        if not marker.exists():
            note(f"using {DIR} (~/.fvpn is root-owned)")
            note("fix once with: sudo chown -R $(id -u):$(id -g) ~/.fvpn")
            try:
                marker.write_text("1")
            except OSError:
                pass
    if not SOURCES.exists():
        SOURCES.write_text(
            "# fvpn sources - one subscription URL or local file per line.\n"
            "# Add your own with: fvpn -i <url>\n"
            + "\n".join(DEFAULT_SOURCES) + "\n"
        )


def load_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


def save_json(path: Path, data) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2))
    tmp.replace(path)


def secret() -> str:
    ensure_dirs()
    if not SECRET_FILE.exists():
        SECRET_FILE.write_text(base64.urlsafe_b64encode(os.urandom(18)).decode())
        os.chmod(SECRET_FILE, 0o600)
    return SECRET_FILE.read_text().strip()


def mihomo_bin() -> str:
    for cand in (shutil.which("mihomo"), "/opt/homebrew/bin/mihomo", "/usr/local/bin/mihomo"):
        if cand and Path(cand).exists():
            return cand
    die("mihomo is not installed. Run: brew install mihomo")


def free_port(start: int) -> int:
    for port in range(start, start + 40):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                s.bind(("127.0.0.1", port))
                return port
            except OSError:
                continue
    die(f"no free port near {start}")


# ---------------------------------------------------------------- http / api

def http_get(url: str, timeout: int = 45) -> bytes:
    req = urllib.request.Request(
        url, headers={"User-Agent": USER_AGENT, "Accept": "*/*"}
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def api(path: str, method: str = "GET", body=None, timeout: float = 3.0, port: int | None = None):
    if port is None:
        rt = load_json(RUNTIME, {})
        port = rt.get("ctrl", PREF_CTRL_PORT)
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        f"http://127.0.0.1:{port}{path}",
        method=method,
        data=data,
        headers={
            "Authorization": f"Bearer {secret()}",
            "Content-Type": "application/json",
        },
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read()
    return json.loads(raw) if raw else {}


def api_ok() -> bool:
    try:
        api("/version", timeout=1.0)
        return True
    except Exception:
        return False


# ---------------------------------------------------------------- process

def pid_alive(pid: int) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def running(rt: dict | None = None) -> bool:
    rt = rt if rt is not None else load_json(RUNTIME, None)
    if not rt:
        return False
    pid = int(rt.get("pid") or 0)
    if not pid_alive(pid):
        return False
    try:
        cmd = subprocess.run(
            ["ps", "-p", str(pid), "-o", "command="],
            capture_output=True, text=True, timeout=3,
        ).stdout
        if "mihomo" in cmd:
            return True
    except Exception:
        pass
    return api_ok()


