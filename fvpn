{cyan('other')}
  fvpn logs [-f]         show / follow the backend log
  fvpn -h                this help

{cyan('files')}
  {SOURCES}
  {CONFIG}
  {LOG}

{dim('Free public nodes are run by strangers: assume they can see your traffic.')} 
{dim('Use them for casual browsing, not banking or work logins.')}
"""


def main(argv: list[str]) -> int:
    normalize_terminal()
    args = argv[1:]
    if not args:
        print(HELP)
        return 0

    flags = {a for a in args if a.startswith("--")}
    words = [a for a in args if not a.startswith("-")]
    first = words[0] if words else ""

    cmd_map = {
        "-c": "connect", "connect": "connect", "--connect": "connect",
        "-d": "disconnect", "disconnect": "disconnect", "--disconnect": "disconnect",
        "-s": "status", "status": "status", "--status": "status",
        "-l": "list", "list": "list", "--list": "list",
        "-t": "test", "test": "test", "--test": "test",
        "-u": "update", "update": "update", "--update": "update",
        "-i": "add", "add": "add", "--add": "add",
        "-p": "use", "use": "use", "--use": "use",
        "-a": "auto", "auto": "auto", "--auto": "auto",
        "-g": "geo", "geo": "geo", "--geo": "geo",
        "logs": "logs", "log": "logs",
        "-h": "help", "--help": "help", "help": "help",
        "-v": "version", "--version": "version", "version": "version",
    }
    cmd = cmd_map.get(args[0], cmd_map.get(first))
    if not cmd:
        say(red(f"unknown command: {args[0]}"))
        print(HELP)
        return 2

    if cmd not in ("connect", "disconnect"):
        heal_stale_proxy()

    if cmd == "help":
        print(HELP)
        return 0
    if cmd == "version":
        say(f"{APP} {VERSION} | backend: {mihomo_bin() if shutil.which('mihomo') or Path('/opt/homebrew/bin/mihomo').exists() else 'missing'}")
        return 0
    if cmd == "connect":
        return cmd_connect(proxy_mode="--proxy" in flags)
    if cmd == "disconnect":
        return cmd_disconnect()
    if cmd == "status":
        print_status()
        return 0
    if cmd == "list":
        return cmd_list(show_all="--all" in flags)
    if cmd == "test":
        return cmd_test()
    if cmd == "update":
        return cmd_update(no_test="--no-test" in flags)
    if cmd == "add":
        rest = [a for a in args[1:] if not a.startswith("-")]
        src = rest[0] if rest else os.environ.get("FVPN_SUB", "")
        if not src:
            die("usage: fvpn -i <subscription-url|file>")
        return cmd_add(src)
    if cmd == "use":
        rest = [a for a in args[1:] if not a.startswith("-")]
        if not rest:
            die("usage: fvpn -p <#>|name")
        return cmd_use(rest[0])
    if cmd == "auto":
        return cmd_auto()
    if cmd == "geo":
        rest = [a for a in args[1:] if not a.startswith("-")]
        return cmd_geo(rest[0] if rest else None)
    if cmd == "logs":
        return cmd_logs(follow="-f" in args or "--follow" in args)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        say("\ninterrupted")
        sys.exit(130)
