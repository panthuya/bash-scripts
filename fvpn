def list_services() -> list[tuple[str, str]]:
    try:
        out = subprocess.run(
            ["networksetup", "-listnetworkserviceorder"],
            capture_output=True, text=True, timeout=10,
        ).stdout
    except Exception:
        return []
    services, cur = [], None
    for line in out.splitlines():
        m = re.match(r"\(\d+\)\s+(.+)$", line.strip())
        if m:
            cur = m.group(1).strip()
            continue
        m2 = re.search(r"Device:\s*([^)]+)\)", line)
        if m2 and cur:
            services.append((cur, m2.group(1).strip()))
    return services


def active_service() -> str:
    iface = None
    try:
        out = subprocess.run(
            ["route", "-n", "get", "default"],
            capture_output=True, text=True, timeout=5,
        ).stdout
        m = re.search(r"interface:\s*(\S+)", out)
        iface = m.group(1) if m else None
    except Exception:
        pass
    for svc, dev in list_services():
        if dev and dev == iface:
            return svc
    return "Wi-Fi"


PROXY_KINDS = [
    ("web", "-getwebproxy", "-setwebproxy", "-setwebproxystate"),
    ("secure", "-getsecurewebproxy", "-setsecurewebproxy", "-setsecurewebproxystate"),
    ("socks", "-getsocksfirewallproxy", "-setsocksfirewallproxy", "-setsocksfirewallproxystate"),
]


def parse_proxy_out(text: str) -> dict:
    d = {"enabled": False, "server": "", "port": 0}
    for line in text.splitlines():
        if line.startswith("Enabled:"):
            d["enabled"] = line.split(":", 1)[1].strip().lower() == "yes"
        elif line.startswith("Server:"):
            d["server"] = line.split(":", 1)[1].strip()
        elif line.startswith("Port:"):
            try:
                d["port"] = int(line.split(":", 1)[1].strip())
            except ValueError:
                d["port"] = 0
    return d


def get_bypass(service: str) -> list[str]:
    res = run_ns("-getproxybypassdomains", service)
    if res.returncode != 0:
        return []
    vals = [x.strip() for x in res.stdout.splitlines() if x.strip()]
    if vals and vals[0].lower().startswith("there aren't any"):
        return []
    return vals


def apply_system_proxy(port: int) -> bool:
    service = active_service()
    backup = {"service": service, "kinds": {}, "bypass": get_bypass(service)}
    for kind, getter, setter, stater in PROXY_KINDS:
        res = run_ns(getter, service)
        backup["kinds"][kind] = parse_proxy_out(res.stdout) if res.returncode == 0 else {"enabled": False, "server": "", "port": 0}
    save_json(BACKUP, backup)

    ok = True
    for kind, getter, setter, stater in PROXY_KINDS:
        res = run_ns(setter, service, "127.0.0.1", str(port))
        res2 = run_ns(stater, service, "on")
        if res.returncode != 0 or res2.returncode != 0:
            ok = False
    run_ns("-setproxybypassdomains", service, "localhost", "127.0.0.1", "*.local", "169.254/16")
    if ok:
        say(dim(f"  system proxy -> {service} 127.0.0.1:{port}"))
    return ok


def restore_system_proxy() -> None:
    backup = load_json(BACKUP, None)
    if not backup:
        return
    service = backup.get("service") or "Wi-Fi"
    for kind, getter, setter, stater in PROXY_KINDS:
        old = (backup.get("kinds") or {}).get(kind) or {}
        if old.get("enabled") and old.get("server"):
            run_ns(setter, service, old["server"], str(old.get("port") or 80))
            run_ns(stater, service, "on")
        else:
            run_ns(stater, service, "off")
    bypass = backup.get("bypass") or []
    if bypass:
        run_ns("-setproxybypassdomains", service, *bypass)
    else:
        run_ns("-setproxybypassdomains", service, "Empty")
    try:
        BACKUP.unlink()
    except FileNotFoundError:
        pass
    say(dim(f"  system proxy restored on {service}"))


