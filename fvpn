def read_sources() -> list[str]:
    ensure_dirs()
    out = []
    for line in SOURCES.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            out.append(line)
    return out


def source_slug(src: str) -> str:
    if src.startswith(("http://", "https://")):
        p = urllib.parse.urlsplit(src)
        base = Path(p.path).stem or "sub"
        h = hashlib.sha1(src.encode()).hexdigest()[:6]
        return re.sub(r"[^a-zA-Z0-9_-]", "", f"{p.hostname}-{base}")[:40] + f"-{h}"
    p = Path(src).expanduser()
    h = hashlib.sha1(str(p).encode()).hexdigest()[:6]
    return re.sub(r"[^a-zA-Z0-9_-]", "", p.stem)[:40] + f"-{h}"


def source_label(src: str) -> str:
    if src.startswith(("http://", "https://")):
        p = urllib.parse.urlsplit(src)
        return f"{p.hostname}{p.path}"[:58]
    return str(Path(src).expanduser())


def decode_subscription(raw: bytes) -> str:
    text = raw.decode("utf-8", "replace").strip()
    if "://" in text:
        return text
    # base64-wrapped whole subscription
    candidate = b64_text(text)
    return candidate if "://" in candidate else text


def parse_source_text(text: str) -> list[dict]:
    if re.search(r"^\s*proxies\s*:", text, re.M) or text.lstrip().startswith("proxy-groups"):
        raise ValueError("Clash/YAML subscription (not supported - use a v2ray/URI subscription)")
    nodes, seen = [], set()
    for line in text.splitlines():
        line = line.strip()
        if "://" not in line:
            continue
        node = parse_uri(line)
        if not node:
            continue
        k = node_key(node)
        if k in seen:
            continue
        seen.add(k)
        nodes.append(node)
    return nodes


def probe(server: str, port: int, timeout: float) -> float | None:
    t0 = time.monotonic()
    try:
        with socket.create_connection((server, port), timeout=timeout):
            return (time.monotonic() - t0) * 1000.0
    except OSError:
        return None


def preflight(nodes: list[dict], timeout: float = 1.0, workers: int = 200) -> list[tuple[dict, float]]:
    try:  # many parallel sockets; the macOS default soft limit is low
        import resource
        soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
        resource.setrlimit(resource.RLIMIT_NOFILE, (min(8192, hard), hard))
    except Exception:
        pass
    live: list[tuple[dict, float]] = []
    total = len(nodes)
    done = 0
    with ThreadPoolExecutor(max_workers=workers) as ex:
        futs = {
            ex.submit(probe, n["server"], n["port"], timeout): n for n in nodes
        }
        for fut in as_completed(futs):
            node = futs[fut]
            done += 1
            ms = fut.result()
            if ms is not None:
                live.append((node, ms))
            if total >= 400 and done % 500 == 0 and TTY:
                print(dim(f"  probed {done}/{total}..."), end="\r", flush=True)
    if TTY and total >= 400:
        print(" " * 32, end="\r", flush=True)
    return live


