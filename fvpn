def delay_of(name: str, proxies: dict | None = None) -> float | None:
    try:
        if proxies is None:
            payload = api("/proxies")
            proxies = payload.get("proxies") or payload
        entry = proxies.get(name) or {}
        hist = entry.get("history") or []
        if hist:
            return float(hist[-1].get("delay") or 0)
    except Exception:
