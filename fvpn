    """name -> proxy object, for nodes supplied by proxy providers."""
    try:
        payload = api("/providers/proxies", timeout=20, port=port)
    except Exception:
        return {}
    out: dict[str, dict] = {}
    for prov in (payload.get("providers") or {}).values():
