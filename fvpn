CHECK_ROUNDS = [
    ("https://www.gstatic.com/generate_204", 4000),
    ("https://www.wikipedia.org/", 5000),
    ("https://github.com/", 5000),
]


def _prune_round(by_source: dict[str, list[dict]], url: str,
                 timeout_ms: int) -> tuple[dict[str, list[dict]], int]:
    """One real-traffic round: load the pool in a throwaway mihomo, health-check
    every node against `url`, and keep only nodes that get a response."""
    tmpdir = DIR / "tmpcheck"
    shutil.rmtree(tmpdir, ignore_errors=True)
    tmpdir.mkdir(parents=True, exist_ok=True)
    slugs = list(by_source)
    mixed, ctrl = free_port(17890), free_port(19090)
    fake_meta = {"providers": [{"slug": s, "count": 1} for s in slugs]}
    cfg = build_config("proxy", mixed, ctrl, fake_meta)
    cfg["dns"]["listen"] = ""
    conf = DIR / "check-config.yaml"
    conf.write_text(json.dumps(cfg, ensure_ascii=False, indent=2))
    logf = open(tmpdir / "mihomo.log", "wb")
    proc = subprocess.Popen(
        [mihomo_bin(), "-d", str(DIR), "-f", str(conf), "-ext-ctl", f"127.0.0.1:{ctrl}"],
        stdout=logf, stderr=logf, start_new_session=True,
    )
    try:
        up = False
        for _ in range(80):
            if proc.poll() is not None:
                break
            try:
                api("/version", timeout=1, port=ctrl)
                up = True
                break
            except Exception:
                time.sleep(0.25)
        if not up:
            return by_source, 0

        healthcheck_providers(slugs, port=ctrl, timeout_ms=timeout_ms, url=url)
        details = provider_details(port=ctrl)
        kept: dict[str, list[tuple[dict, int]]] = {s: [] for s in slugs}
        for slug, nodes in by_source.items():
            for node in nodes:
                hist = (details.get(node["name"]) or {}).get("history") or []
                if hist:
                    ms = int(hist[-1].get("delay") or 0)
                    if ms > 0:
                        kept[slug].append((node, ms))
        total = sum(len(v) for v in kept.values())
        if total < 5:
            return by_source, total
        for bucket in kept.values():
            bucket.sort(key=lambda x: x[1])
        return {s: [n for n, _ms in v] for s, v in kept.items()}, total
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=8)
        except subprocess.TimeoutExpired:
            proc.kill()
        logf.close()
        try:
            conf.unlink()
        except FileNotFoundError:
            pass
        shutil.rmtree(tmpdir, ignore_errors=True)


def prune_pool(by_source: dict[str, list[dict]]) -> tuple[dict[str, list[dict]], int]:
    """Verify the pool against several real destinations. A node has to work
    for all of them, which filters out SNI-whitelisting relays that only answer
    the health-check URL."""
    current = by_source
    for i, (url, tmo) in enumerate(CHECK_ROUNDS):
        host = urllib.parse.urlsplit(url).hostname
        count = sum(len(v) for v in current.values())
        print(dim(f"\n  verifying {count} nodes via {host} ... "), end="", flush=True)
        kept, working = _prune_round(current, url, tmo)
        if working >= 5:
            current = kept
            say(green(f"{working} ok"))
        else:
            if i == 0:
                return by_source, 0
            say(yellow(f"only {working} ok, stopping here"))
            break
    total = sum(len(v) for v in current.values())
    return current, total


def cmd_update(no_test: bool = False) -> int:
    ensure_dirs()
    if running():
        die("disconnect first: fvpn -d")
    sources = read_sources()
    if not sources:
        die(f"no sources configured - edit {SOURCES}")

    say(bold("refreshing nodes"))
    all_nodes: list[dict] = []
    seen: set = set()
    ok_slugs: list[tuple[str, str]] = []
    failures = 0

    for i, src in enumerate(sources, 1):
        label = source_label(src)
        slug = source_slug(src)
        print(dim(f"  [{i}/{len(sources)}] {label} ... "), end="", flush=True)
        try:
            if src.startswith(("http://", "https://")):
                raw = http_get(src)
            else:
                path = Path(src).expanduser()
                if not path.exists():
                    raise FileNotFoundError(str(path))
                raw = path.read_bytes()
            nodes = parse_source_text(decode_subscription(raw))
        except Exception as e:
            failures += 1
            say(red(f"skip ({str(e)[:60]})"))
            continue
        fresh = 0
        for n in nodes:
            k = node_key(n)
            if k in seen:
                continue
            seen.add(k)
            n["_src"] = slug
            all_nodes.append(n)
            fresh += 1
        ok_slugs.append((src, slug))
        say(f"{len(nodes)} parsed, {fresh} new")

    if not all_nodes:
        die("no usable nodes found in any source")

    # Even sample if the raw pool is huge, so one giant list can't starve others.
    if len(all_nodes) > MAX_CANDIDATES:
        step = len(all_nodes) / MAX_CANDIDATES
        all_nodes = [all_nodes[int(i * step)] for i in range(MAX_CANDIDATES)]
        say(dim(f"  sampling {MAX_CANDIDATES} candidates"))

    if no_test:
        live = [(n, 9999.0) for n in all_nodes]
        say(dim("  skipping reachability test (--no-test)"))
    else:
        print(dim(f"  checking reachability of {len(all_nodes)} nodes ... "), end="", flush=True)
        live = preflight(all_nodes)
        say(f"{green(str(len(live)))} reachable")

    if not live:
        die("every node failed the reachability check - try again later, or add a subscription with: fvpn -i <url>")

    live.sort(key=lambda x: x[1])
    # 70% purely by latency, the rest spread across sources so one fast list
    # cannot starve the others (and the pool survives one source going stale).
    cut = max(1, int(MAX_NODES * 0.7))
    kept = live[:cut]
    rest = live[cut:]
    per_source: dict[str, list] = {}
    for node, ms in rest:
        per_source.setdefault(node.get("_src", "_"), []).append((node, ms))
    while len(kept) < MAX_NODES and per_source:
        for slug in list(per_source):
            bucket = per_source[slug]
            if bucket and len(kept) < MAX_NODES:
                kept.append(bucket.pop(0))
            if not bucket:
                del per_source[slug]

    # group survivors by their origin source, guarantee unique names
    used_names = set(RESERVED_NAMES)
    by_source: dict[str, list[dict]] = {}
    for node, _ms in kept:
        slug = node.pop("_src", "_")
        name = node["name"]
        if name in used_names:
            base, k = name, 2
            while f"{base} #{k}" in used_names:
                k += 1
            name = f"{base} #{k}"
        used_names.add(name)
        node["name"] = name
        by_source.setdefault(slug, []).append(node)

    # write a first cut so the verifier can load the pool
    for slug, nodes in by_source.items():
        write_provider(slug, nodes)

    if not no_test:
        pruned, working = prune_pool(by_source)
        if working >= 5:
            dropped = sum(len(v) for v in by_source.values()) - sum(len(v) for v in pruned.values())
            by_source = pruned
            say(dim(f"  {green(str(working))} nodes passed every check {dim(f'({dropped} dead removed)')}"))
        else:
            say(yellow("  too few nodes passed, keeping the larger pool"))

    meta = {"updated": time.time(), "candidates": len(all_nodes), "live": len(live), "providers": []}
    for src, slug in ok_slugs:
        nodes = by_source.get(slug) or []
        if not nodes:
            continue
        write_provider(slug, nodes)
        meta["providers"].append({"slug": slug, "source": source_label(src), "count": len(nodes)})

    if not meta["providers"]:
        die("no live nodes left after filtering")

    # drop providers that no longer exist in sources.conf
    active = {p["slug"] for p in meta["providers"]}
    for stale in PROVIDERS.glob("*.yaml"):
        if stale.stem not in active:
            stale.unlink()
    save_json(META, meta)

    write_config("tun", PREF_MIXED_PORT, PREF_CTRL_PORT, meta)
    check = subprocess.run(
        [mihomo_bin(), "-t", "-d", str(DIR), "-f", str(CONFIG)],
        capture_output=True, text=True, timeout=180,
    )
    if check.returncode != 0:
        out = (check.stderr or check.stdout or "").strip()
        say(dim(out[-1500:]))
        die("node set produced an invalid config - please report this")

    say("")
    for p in meta["providers"]:
        say(f"  {green(str(p['count']).rjust(4))}  {p['source']}")
    say("")
    say(f"{green(str(sum(p['count'] for p in meta['providers'])))} nodes ready {dim('(from ' + str(meta['live']) + ' reachable)')}")
    if failures:
        say(dim(f"  {failures} source(s) skipped"))
    say(dim("  connect with: fvpn -c"))
    return 0


