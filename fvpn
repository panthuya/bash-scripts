def ensure_sudo() -> bool:
    if os.geteuid() == 0:
        return True
    if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0:
        return True
    say(dim("TUN mode needs admin rights once (it routes every app)."))
    return subprocess.run(["sudo", "-v"]).returncode == 0


def run_ns(*args: str, timeout: float = 15) -> subprocess.CompletedProcess:
    """networksetup wrapper; retries with cached sudo when needed."""
    res = subprocess.run(["networksetup", *args], capture_output=True, text=True, timeout=timeout)
    if res.returncode != 0 and os.geteuid() != 0:
        res2 = subprocess.run(
            ["sudo", "-n", "networksetup", *args],
            capture_output=True, text=True, timeout=timeout,
        )
        if res2.returncode == 0:
            return res2
    return res


# ---------------------------------------------------------------- URI parsing
# Every parser returns a Clash/mihomo proxy dict or None when unsupported.

def b64(text: str) -> bytes:
    s = re.sub(r"\s+", "", text).replace("-", "+").replace("_", "/")
    if len(s) % 4:
        s += "=" * (4 - len(s) % 4)
    return base64.b64decode(s, validate=False)


def b64_text(text: str) -> str:
    try:
        return b64(text).decode("utf-8", "replace")
    except Exception:
        return ""


def q1(qs: dict, *keys: str, default: str = "") -> str:
    for k in keys:
        vals = qs.get(k)
        if vals and vals[0] != "":
            return vals[0]
    return default


def truthy(v) -> bool:
    return str(v).strip().lower() in ("1", "true", "yes", "on")


def clean_name(raw: str | None, fallback: str) -> str:
    name = urllib.parse.unquote(raw or "").strip()
    name = re.sub(r"[\x00-\x1f\x7f]", "", name).strip(" -|#")
    if not name:
        name = fallback
    return name[:64]


def split_hostport(hp: str) -> tuple[str, int] | None:
    hp = hp.strip().strip("/")
    if hp.startswith("["):  # [v6]:port
        m = re.match(r"\[([^\]]+)\]:(\d+)", hp)
        if not m:
            return None
        return m.group(1), int(m.group(2))
    if hp.count(":") != 1:
        return None
    host, port = hp.rsplit(":", 1)
    if not port.isdigit():
        return None
    return host, int(port)


def apply_transport(d: dict, qs: dict, network: str, *, host: str = "", path: str = "", service: str = "") -> dict:
    network = (network or "tcp").lower()
    if network in ("tcp", "raw", ""):
        return d
    if network == "ws":
        d["network"] = "ws"
        opts = {"path": path or "/"}
        if host:
            opts["headers"] = {"Host": host}
        d["ws-opts"] = opts
    elif network == "grpc":
        d["network"] = "grpc"
        svc = service or path.lstrip("/")
        if svc:
            d["grpc-opts"] = {"grpc-service-name": svc}
    elif network in ("h2", "http"):
        d["network"] = "h2"
        opts = {}
        if host:
            opts["host"] = [h for h in host.split(",") if h]
        if path:
            opts["path"] = path
        if opts:
            d["h2-opts"] = opts
    else:
        return {}
    return d


def parse_vless(uri: str) -> dict | None:
    u = urllib.parse.urlsplit(uri)
    qs = urllib.parse.parse_qs(u.query, keep_blank_values=True)
    if not u.hostname or not u.port:
        return None
    security = q1(qs, "security").lower()
    network = q1(qs, "type", default="tcp").lower()
    if network in ("xhttp", "splithttp", "kcp", "quic", "httpupgrade", "meek"):
        return None
    d = {
        "name": clean_name(u.fragment, f"VLESS {u.hostname}:{u.port}"),
        "type": "vless",
        "server": u.hostname,
        "port": int(u.port),
        "uuid": urllib.parse.unquote(u.username or ""),
        "udp": True,
    }
    if not d["uuid"]:
        return None
    if security in ("tls", "reality", "xtls"):
        d["tls"] = True
        sni = q1(qs, "sni", "peer")
        if sni:
            d["servername"] = sni
        if security == "reality":
            pbk = q1(qs, "pbk", "publicKey")
            sid = q1(qs, "sid", "shortId")
            if not pbk:
                return None
            d["reality-opts"] = {"public-key": pbk}
            if sid:
                d["reality-opts"]["short-id"] = sid
            d["client-fingerprint"] = q1(qs, "fp", "fingerprint", default="chrome")
        else:
            if truthy(q1(qs, "allowInsecure", "insecure")):
                d["skip-cert-verify"] = True
            fp = q1(qs, "fp")
            if fp:
                d["client-fingerprint"] = fp
            alpn = q1(qs, "alpn")
            if alpn:
                d["alpn"] = [a for a in alpn.split(",") if a]
    flow = q1(qs, "flow")
    if flow.startswith("xtls-rprx-vision"):
        d["flow"] = flow
    d = apply_transport(
        d, qs, network,
        host=q1(qs, "host"),
        path=q1(qs, "path"),
        service=q1(qs, "serviceName"),
    )
    return d or None


def parse_vmess(uri: str) -> dict | None:
    body = uri[len("vmess://"):].split("#", 1)[0].strip()
    try:
        js = json.loads(b64_text(body))
    except Exception:
        return None
    if not isinstance(js, dict):
        return None
    server, port, uuid = js.get("add"), js.get("port"), js.get("id")
    if not server or not uuid:
        return None
    try:
        port = int(port)
    except (TypeError, ValueError):
        return None
    if not (0 < port < 65536):
        return None
    d = {
        "name": clean_name(js.get("ps"), f"VMess {server}:{port}"),
        "type": "vmess",
        "server": str(server).strip("[]"),
        "port": port,
        "uuid": str(uuid),
        "alterId": int(js.get("aid") or 0),
        "cipher": "auto",
        "udp": True,
    }
    if str(js.get("tls", "")).lower() in ("tls", "true", "reality", "1"):
        d["tls"] = True
        sni = js.get("sni") or js.get("host") or ""
        if sni:
            d["servername"] = sni
        if truthy(js.get("allowInsecure")):
            d["skip-cert-verify"] = True
        if js.get("fp"):
            d["client-fingerprint"] = str(js["fp"])
        if js.get("alpn"):
            d["alpn"] = [a for a in str(js["alpn"]).split(",") if a]
    net = str(js.get("net") or "tcp").lower()
    if net in ("xhttp", "kcp", "quic"):
        return None
    d = apply_transport(
        d, {}, net,
        host=str(js.get("host") or ""),
        path=str(js.get("path") or ""),
        service=str(js.get("path") or ""),
    )
    return d or None


def parse_trojan(uri: str) -> dict | None:
    u = urllib.parse.urlsplit(uri)
    if not u.hostname or not u.port:
        return None
    password = urllib.parse.unquote(u.username or "")
    if not password:
        return None
    qs = urllib.parse.parse_qs(u.query, keep_blank_values=True)
    d = {
        "name": clean_name(u.fragment, f"Trojan {u.hostname}:{u.port}"),
        "type": "trojan",
        "server": u.hostname,
        "port": int(u.port),
        "password": password,
        "udp": True,
    }
    sni = q1(qs, "sni", "peer", "host")
    if sni:
        d["sni"] = sni
    if truthy(q1(qs, "allowInsecure", "insecure")):
        d["skip-cert-verify"] = True
    alpn = q1(qs, "alpn")
    if alpn:
        d["alpn"] = [a for a in alpn.split(",") if a]
    if truthy(q1(qs, "allowInsecure")):
        d["skip-cert-verify"] = True
    net = q1(qs, "type", default="tcp")
    d = apply_transport(
        d, qs, net,
        host=q1(qs, "host"),
        path=q1(qs, "path"),
        service=q1(qs, "serviceName"),
    )
    return d or None


def parse_ss(uri: str) -> dict | None:
    body = uri[len("ss://"):]
    name_raw = ""
    if "#" in body:
        body, name_raw = body.split("#", 1)
    query = ""
    if "?" in body:
        body, query = body.split("?", 1)
    if "@" in body:
        userinfo, hostport = body.rsplit("@", 1)
        if ":" not in userinfo:
            userinfo = b64_text(userinfo)
    else:
        decoded = b64_text(body)
        if "@" not in decoded:
            return None
        userinfo, hostport = decoded.rsplit("@", 1)
    if ":" not in userinfo:
        return None
    method, password = userinfo.split(":", 1)
    method = method.strip().lower()
    password = urllib.parse.unquote(password)
    method = SS_ALIASES.get(method, method)
    if method not in SS_CIPHERS or not password:
        return None
    hp = split_hostport(hostport.split("/", 1)[0])
    if not hp:
        return None
    server, port = hp
    d = {
        "name": clean_name(name_raw, f"SS {server}:{port}"),
        "type": "ss",
        "server": server,
        "port": port,
        "cipher": method,
        "password": password,
        "udp": True,
    }
    qs = urllib.parse.parse_qs(query, keep_blank_values=True)
    plugin = q1(qs, "plugin")
    if plugin:
        parts = {}
        for chunk in plugin.split(";"):
            if "=" in chunk:
                k, v = chunk.split("=", 1)
                parts[k.strip()] = v
            elif chunk.strip():
                parts["_name"] = chunk.strip()
        pname = parts.pop("_name", "")
        if pname in ("obfs-local", "simple-obfs", "obfs"):
            mode = parts.get("obfs", "http")
            d["plugin"] = "obfs"
            d["plugin-opts"] = {"mode": mode}
            if parts.get("obfs-host"):
                d["plugin-opts"]["host"] = parts["obfs-host"]
        elif pname == "v2ray-plugin":
            d["plugin"] = "v2ray-plugin"
            d["plugin-opts"] = {
                "mode": "websocket",
                "host": parts.get("host", ""),
                "path": parts.get("path", "/"),
            }
            if "tls" in parts:
                d["plugin-opts"]["tls"] = True
        else:
            return None
    return d


def parse_hysteria2(uri: str) -> dict | None:
    u = urllib.parse.urlsplit(uri)
    if not u.hostname or not u.port:
        return None
    qs = urllib.parse.parse_qs(u.query, keep_blank_values=True)
    password = urllib.parse.unquote(u.username or "") or q1(qs, "password", "auth")
    if not password:
        return None
    d = {
        "name": clean_name(u.fragment, f"HY2 {u.hostname}:{u.port}"),
        "type": "hysteria2",
        "server": u.hostname,
        "port": int(u.port),
        "password": password,
        "udp": True,
    }
    sni = q1(qs, "sni", "peer")
    if sni:
        d["sni"] = sni
    if truthy(q1(qs, "insecure", "allowInsecure")):
        d["skip-cert-verify"] = True
    obfs = q1(qs, "obfs")
    if obfs:
        d["obfs"] = obfs
        op = q1(qs, "obfs-password", "obfsPassword")
        if op:
            d["obfs-password"] = op
    alpn = q1(qs, "alpn")
    if alpn:
        d["alpn"] = [a for a in alpn.split(",") if a]
    return d


def parse_tuic(uri: str) -> dict | None:
    u = urllib.parse.urlsplit(uri)
    if not u.hostname or not u.port:
        return None
    uuid = urllib.parse.unquote(u.username or "")
    password = urllib.parse.unquote(u.password or "")
    if not uuid:
        return None
    qs = urllib.parse.parse_qs(u.query, keep_blank_values=True)
    d = {
        "name": clean_name(u.fragment, f"TUIC {u.hostname}:{u.port}"),
        "type": "tuic",
        "server": u.hostname,
        "port": int(u.port),
        "uuid": uuid,
        "password": password,
        "udp": True,
        "reduce-rtt": True,
    }
    sni = q1(qs, "sni", "peer")
    if sni:
        d["sni"] = sni
    alpn = q1(qs, "alpn")
    if alpn:
        d["alpn"] = [a for a in alpn.split(",") if a]
    if truthy(q1(qs, "allow_insecure", "allowInsecure", "insecure")):
        d["skip-cert-verify"] = True
    cc = q1(qs, "congestion_control", "congestion-controller")
    if cc:
        d["congestion-controller"] = cc
    mode = q1(qs, "udp_relay_mode", "udp-relay-mode")
    if mode:
        d["udp-relay-mode"] = mode
    return d


PARSERS = {
    "vless": parse_vless,
    "vmess": parse_vmess,
    "trojan": parse_trojan,
    "ss": parse_ss,
    "hysteria2": parse_hysteria2,
    "hy2": parse_hysteria2,
    "tuic": parse_tuic,
}


def parse_uri(uri: str) -> dict | None:
    uri = uri.strip()
    if "://" not in uri:
        return None
    scheme = uri.split("://", 1)[0].lower()
    fn = PARSERS.get(scheme)
    if not fn:
        return None
    try:
        node = fn(uri)
    except Exception:
        return None
    if not node:
        return None
    server = str(node.get("server", "")).strip("[]")
    if not server or server.lower() in ("127.0.0.1", "localhost", "0.0.0.0", "::1"):
        return None
    if not isinstance(node.get("port"), int) or not (0 < node["port"] < 65536):
        return None
    name = node.get("name") or ""
    if JUNK_NAME.search(name):
        return None
    node["server"] = server
    node["name"] = name
    return node


def node_key(n: dict):
    auth = n.get("uuid") or n.get("password") or ""
    net = n.get("network") or "tcp"
    ws = (n.get("ws-opts") or {}).get("path", "")
    grpc = (n.get("grpc-opts") or {}).get("grpc-service-name", "")
    return (n["type"], n["server"].lower(), n["port"], auth, net, ws, grpc)


