        hist = e.get("history") or []
        if hist:
            delay = float(hist[-1].get("delay") or 0)
        rows.append((name, e.get("type", "?"), delay))
    rows.sort(key=lambda r: (r[2] is None, r[2] if r[2] is not None else 1e9))
    return rows


def healthcheck_providers(slugs: list[str], port: int | None = None,
                          timeout_ms: int = 4000, url: str = HEALTH_URL) -> None:
    q = urllib.parse.quote(url, safe="")
    for slug in slugs:
        path = (f"/providers/proxies/{urllib.parse.quote(slug, safe='')}"
                f"/healthcheck?url={q}&timeout={timeout_ms}")
        try:
            api(path, timeout=180, port=port)
        except Exception:
            continue


def group_test(timeout_ms: int = 4000) -> dict:
    q = urllib.parse.quote(HEALTH_URL, safe="")
    try:
        return api(f"/group/AUTO/delay?url={q}&timeout={timeout_ms}", timeout=90)
    except Exception:
        return {}


# ---------------------------------------------------------------- geo

def geo_lookup(port: int, timeout: int = 7) -> dict | None:
    """Exit IP / country as seen from outside, through the local proxy."""
    for url in ("https://ipinfo.io/json", "https://ipapi.co/json/"):
        try:
            res = subprocess.run(
                ["curl", "-sS", "--max-time", str(timeout),
                 "--proxy", f"http://127.0.0.1:{port}", url],
                capture_output=True, text=True, timeout=timeout + 3,
            )
            js = json.loads(res.stdout)
            cc = (js.get("country") or js.get("country_code") or "").upper()
            if cc:
                return {
                    "country": cc,
                    "ip": js.get("ip") or "",
                    "org": js.get("org") or js.get("asn") or "",
                }
        except Exception:
            continue
    return None


def geo_cache() -> dict:
    return load_json(GEO, {})


def save_geo(cache: dict) -> None:
    save_json(GEO, cache)


def cmd_geo(want: str | None = None) -> int:
    if not (running() and api_ok()):
        die("not connected - start with: fvpn -c")

    mixed = int(load_json(RUNTIME, {}).get("mixed", PREF_MIXED_PORT))
    _grp, node = current_proxy()

    if not want:
        info = geo_lookup(mixed)
        say(bold("exit"))
        say(f"  node     {node}")
        if info:
            say(f"  country  {info['country']}  {dim(info.get('org', '')[:48])}")
            say(f"  ip       {info['ip']}")
            if info["country"] in ("IR", "CN", "RU", "KP", "SY", "CU"):
                say(dim("  this exit is in a country many AI APIs block"))
        else:
            say(yellow("  could not determine the exit location"))
        return 0

    want = want.upper()
    rows = node_list()
    if not rows:
        die("no nodes in the pool - run: fvpn -u")

    cache = geo_cache()
    now = time.time()
    tried = 0
    found = None
    available: dict[str, str] = {}

    for name, _ptype, _delay in rows:
        entry = cache.get(name) or {}
        cc = entry.get("country")
        if not cc or now - float(entry.get("ts", 0)) > 21600:
            if tried >= 30:
                break
            tried += 1
            try:
                api("/proxies/PROXY", "PUT", {"name": name})
            except Exception:
                continue
            time.sleep(0.2)
            info = geo_lookup(mixed, timeout=6)
            if not info:
                continue
            cc = info["country"]
            cache[name] = {**info, "ts": now}
            save_geo(cache)
        available[cc] = name
        if cc == want and not found:
            found = name
            break

    if not found:
        say(yellow(f"no node exits in {want}"))
        if available:
            say("seen so far: " + ", ".join(sorted(available)))
        say(dim(f"  scanned {tried} nodes; try again or use: fvpn -l and -p <#>"))
        return 1

    api("/proxies/PROXY", "PUT", {"name": found})
    info = cache.get(found, {})
    say(green(f"pinned {found}"))
    say(f"  exit     {info.get('country', want)}  {dim(info.get('org', ''))}")
    say(f"  ip       {info.get('ip', '?')}")
    return 0


# ---------------------------------------------------------------- commands

def cmd_connect(proxy_mode: bool) -> int:
    ensure_dirs()
    rt = load_json(RUNTIME, None)
    if running(rt):
        mode = rt.get("mode", "tun")
        say(yellow(f"already connected ({mode} mode). Use: fvpn -d"))
        return 0
    if BACKUP.exists():
        # a previous session died mid-flight: put the proxy settings back first
        restore_system_proxy()

    meta = load_json(META, {})
    if not meta.get("providers") or not any(p.get("count", 0) > 0 for p in meta["providers"]):
        say(dim("no nodes cached yet - fetching ..."))
        if cmd_update() != 0:
            return 1
        meta = load_json(META, {})

    mode = "proxy" if proxy_mode else "tun"
    if mode == "tun" and not ensure_sudo():
        say(yellow("admin rights unavailable - falling back to system-proxy mode"))
        mode = "proxy"

    mixed = free_port(PREF_MIXED_PORT)
    ctrl = free_port(PREF_CTRL_PORT)
    write_config(mode, mixed, ctrl, meta)

    # validate before launching
    check = subprocess.run(
        [mihomo_bin(), "-t", "-d", str(DIR), "-f", str(CONFIG)],
        capture_output=True, text=True, timeout=120,
    )
    if check.returncode != 0:
        say(check.stderr.strip()[-1200:] or check.stdout.strip()[-1200:])
        die("generated config is invalid")

    log_start = LOG.stat().st_size if LOG.exists() else 0
    logf = open(LOG, "ab")
    logf.write(f"\n===== {time.strftime('%Y-%m-%d %H:%M:%S')} connect mode={mode} =====\n".encode())
    logf.flush()

    if mode == "tun":
        try:
            PIDFILE.unlink()
        except FileNotFoundError:
            pass
        cmd = [
            "sudo", "sh", "-c",
            'echo $$ > "$1"; exec "$2" -d "$3" -f "$4" -ext-ctl "127.0.0.1:$5"',
            "sh", str(PIDFILE), mihomo_bin(), str(DIR), str(CONFIG), str(ctrl),
        ]
        proc = subprocess.Popen(cmd, stdout=logf, stderr=logf, start_new_session=True)
        pid = 0
        for _ in range(50):
            if PIDFILE.exists():
                try:
                    pid = int(PIDFILE.read_text().strip())
                except ValueError:
                    pid = 0
                if pid:
                    break
            time.sleep(0.1)
        if not pid:
            proc.terminate()
            say(tail_log())
            die("could not start the tunnel (admin rights?)")
    else:
        proc = subprocess.Popen(
            [mihomo_bin(), "-d", str(DIR), "-f", str(CONFIG),
             "-ext-ctl", f"127.0.0.1:{ctrl}"],
            stdout=logf, stderr=logf, start_new_session=True,
        )
        pid = proc.pid
        PIDFILE.write_text(str(pid))

    rt = {
        "pid": pid,
        "mode": mode,
        "mixed": mixed,
        "ctrl": ctrl,
        "started": time.time(),
        "log": str(LOG),
        "config": str(CONFIG),
    }
    save_json(RUNTIME, rt)

    # wait for the API
    up = False
    for _ in range(80):
        if not pid_alive(pid):
            break
        if api_ok():
            up = True
            break
        time.sleep(0.25)
    if not up:
        say(tail_log())
        cmd_disconnect(quiet=True)
        die("backend failed to start - try 'fvpn -c --proxy', or see: fvpn logs")

    if mode == "proxy":
        if not apply_system_proxy(mixed):
            say(yellow("  could not change the system proxy - point apps at 127.0.0.1:%d" % mixed))

    # Ask the url-test group for a quick batch so the first connection lands
    # on a node that already answered a real request.
    print(dim("selecting best node ..."), end="", flush=True)
    group_test(3000)
    print(" " * 30, end="\r", flush=True)

    err = error_lines(log_start)
    if err:
        say(yellow("backend reported errors:"))
        for line in err[-3:]:
            say(dim("  " + line[-150:]))

    say(green("connected") + dim(f"  ({mode} mode)"))
    print_status()
    return 0


def error_lines(since: int = 0) -> list[str]:
    try:
        data = LOG.read_bytes()[since:].decode("utf-8", "replace")
    except Exception:
        return []
    return [l for l in data.splitlines() if "level=error" in l or "operation not permitted" in l]


def tail_log(n: int = 12) -> str:
    try:
        lines = LOG.read_text(errors="replace").splitlines()
    except Exception:
        return ""
    return "\n".join(dim("  " + l[-200:]) for l in lines[-n:])


def safe_kill(pid: int, sig: int) -> None:
    try:
        os.kill(pid, sig)
        return
    except ProcessLookupError:
        return
    except PermissionError:
        pass
    flag = f"-{int(sig)}"
    if subprocess.run(["sudo", "-n", "kill", flag, str(pid)],
                      capture_output=True).returncode == 0:
        return
    if ensure_sudo():
        subprocess.run(["sudo", "kill", flag, str(pid)], capture_output=True)


def cmd_disconnect(quiet: bool = False) -> int:
    rt = load_json(RUNTIME, None)

    # always restore the system proxy, even after a crash
    if BACKUP.exists():
        restore_system_proxy()

    pids: list[int] = []
    if rt and rt.get("pid"):
        pids.append(int(rt["pid"]))
    for p in find_mihomo_pids():
        if p not in pids:
            pids.append(p)

    mode = (rt or {}).get("mode", "tun")
    alive = [p for p in pids if pid_alive(p)]
    if not alive:
        if not quiet:
            say(yellow("not connected"))
        for f in (RUNTIME, PIDFILE):
            try:
                f.unlink()
            except FileNotFoundError:
                pass
        return 0

    for pid in alive:
        safe_kill(pid, signal.SIGTERM)

    for _ in range(30):
        if not any(pid_alive(p) for p in alive):
            break
        time.sleep(0.2)
    for pid in alive:
        if pid_alive(pid):
            safe_kill(pid, signal.SIGKILL)

    if mode == "tun" or os.geteuid() == 0:
        # root-owned cache.db would break the next non-root run
        chown = ["chown", "-R", f"{os.getuid()}:{os.getgid()}", str(DIR)]
        if subprocess.run(["sudo", "-n", *chown], capture_output=True).returncode != 0:
            if os.geteuid() == 0:
                subprocess.run(chown, capture_output=True)
            elif ensure_sudo():
                subprocess.run(["sudo", *chown], capture_output=True)

    for f in (RUNTIME, PIDFILE):
        try:
            f.unlink()
        except FileNotFoundError:
            pass

    if not quiet:
        say(green("disconnected"))
    return 0


def print_status() -> None:
    rt = load_json(RUNTIME, None)
    if not rt or not running(rt):
        meta = load_json(META, {})
        total = sum(p.get("count", 0) for p in meta.get("providers", []))
        say(yellow("not connected"))
        if total:
            say(dim(f"  {total} nodes cached, updated {time.strftime('%Y-%m-%d %H:%M', time.localtime(meta.get('updated', 0)))}"))
        say(dim("  start with: fvpn -c"))
        return

    mode = rt.get("mode", "?")
    mode_txt = "TUN (all traffic)" if mode == "tun" else "system proxy"
    uptime = human_uptime(time.time() - float(rt.get("started", time.time())))
    group, node = current_proxy()
    delay = delay_of(node) if node not in ("-", "AUTO") else None

    say(bold("fvpn status"))
    say(f"  state    {green('connected')}  {dim(uptime)}")
    say(f"  mode     {mode_txt}")
    if node and node != "-":
        d = f" ({int(delay)} ms)" if delay else ""
        label = f"{node}{d}" if group != "AUTO" else f"{node}{d}  {dim('[auto]')}"
        say(f"  node     {label}")
    say(f"  proxy    127.0.0.1:{rt.get('mixed')}  {dim('(http + socks5)')}")
    try:
        conn = api("/connections", timeout=2)
        down = float(conn.get("downloadTotal") or 0)
        up = float(conn.get("uploadTotal") or 0)
        say(f"  traffic  {dim('down')} {human_bytes(down)}  {dim('up')} {human_bytes(up)}")
    except Exception:
        pass
    say(dim(f"  log      {rt.get('log')}"))


def cmd_list(show_all: bool = False) -> int:
    if not (running() and api_ok()):
        meta = load_json(META, {})
        if not meta.get("providers"):
            say(dim("no nodes cached - run: fvpn -u"))
            return 0
        say(bold("cached providers"))
        for p in meta["providers"]:
            say(f"  {p.get('count', 0):>4}  {p.get('source', p.get('slug'))}")
        say(dim("  connect to see live latency: fvpn -c"))
        return 0

    rows = node_list()
    if not rows:
        say(yellow("no nodes in the AUTO group yet - try: fvpn -t"))
        return 0

    _g, now = current_proxy()
    say(bold(f"nodes ({len(rows)})"))
    say(dim("   #    delay  type     name"))
    limit = len(rows) if show_all else min(len(rows), 25)
    for i, (name, ptype, delay) in enumerate(rows[:limit], 1):
        say(node_line(i, delay, ptype, name, current=(name == now)))
    if limit < len(rows):
        say(dim(f"  ... {len(rows) - limit} more (fvpn -l --all)"))
    say(dim("  pin one: fvpn -p <#>   auto: fvpn -a"))
    return 0


def cmd_test() -> int:
    if not (running() and api_ok()):
        die("not connected - start with: fvpn -c")
    meta = load_json(META, {})
    slugs = [p["slug"] for p in meta.get("providers", [])]
    if not slugs:
        die("no nodes in the pool - run: fvpn -u")
    total = sum(p.get("count", 0) for p in meta.get("providers", []))
    say(dim(f"testing {total} nodes ..."))
    healthcheck_providers(slugs, timeout_ms=4000)
    rows = node_list()
    good = sorted((d, n) for n, _t, d in rows if d and d > 0)
    if not good:
        say(yellow("no node passed the test - refresh the pool with: fvpn -u"))
        return 1
    group_test(3000)  # let the auto group pick the winner
    _g, now = current_proxy()
    say(bold(f"working nodes ({len(good)}/{len(rows)})"))
    for i, (ms, name) in enumerate(good[:20], 1):
        say(node_line(i, ms, "", name, current=(name == now)))
    say(dim(f"  best: {good[0][1]} ({good[0][0]} ms)"))
    say(dim("  pin it: fvpn -p 1"))
    return 0


def resolve_node(arg: str) -> str | None:
    rows = node_list()
    if arg.isdigit():
        idx = int(arg) - 1
        if 0 <= idx < len(rows):
            return rows[idx][0]
        return None
    if arg.upper() in ("AUTO", "DIRECT"):
        return arg.upper()
    for name, _t, _d in rows:
        if name == arg:
            return name
    matches = [n for n, _t, _d in rows if arg.lower() in n.lower()]
    return matches[0] if len(matches) == 1 else None


def cmd_use(arg: str) -> int:
    if not (running() and api_ok()):
        die("not connected - start with: fvpn -c")
    name = resolve_node(arg)
    if not name:
        die(f"no unique node matching '{arg}' - see: fvpn -l")
    try:
        api("/proxies/PROXY", "PUT", {"name": name})
    except urllib.error.HTTPError as e:
        die(f"switch failed ({e.code}) - is '{name}' in the list?")
    except Exception as e:
        die(f"switch failed: {e}")
    say(green("node pinned: ") + name)
    return 0


def cmd_auto() -> int:
    if not (running() and api_ok()):
        die("not connected - start with: fvpn -c")
    try:
        api("/proxies/PROXY", "PUT", {"name": "AUTO"})
    except Exception as e:
        die(f"could not switch to auto: {e}")
    say(dim("re-testing nodes ..."))
    group_test(3000)
    _g, now = current_proxy()
    if now and now not in ("-", "AUTO"):
        d = delay_of(now)
        say(green("auto mode: ") + (f"{now} ({int(d)} ms)" if d else now))
    else:
        say(green("auto mode: ") + "mihomo will pick the fastest node on first use")
    return 0


def cmd_add(src: str) -> int:
    ensure_dirs()
    src = src.strip()
    if not src.startswith(("http://", "https://")):
        if not Path(src).expanduser().exists():
            die(f"not a URL or existing file: {src}")
        src = str(Path(src).expanduser().resolve())
    lines = SOURCES.read_text().splitlines()
    if src in lines:
        say("already configured")
        return 0
    lines.insert(0, src)
    SOURCES.write_text("\n".join(lines) + "\n")
    say(green("added: ") + source_label(src))
    say(dim("  refresh nodes with: fvpn -u"))
    return 0


def cmd_logs(follow: bool = False) -> int:
    if not LOG.exists():
        say(dim("no log yet"))
        return 0
    args = ["tail", "-n", "80"] + (["-f"] if follow else []) + [str(LOG)]
    return subprocess.run(args).returncode


